{
  "version": "1",
  "start_url": "https://books.toscrape.com/",
  "item_selector": "article.product_pod",
  "fields": {
    "title": {
      "selector": "h3 a",
      "extract": "attribute",
      "attribute": "title",
      "transform": "none",
      "required": true
    },
    "price": {
      "selector": "p.price_color",
      "extract": "text",
      "attribute": null,
      "transform": "none",
      "required": true
    },
    "url": {
      "selector": "h3 a",
      "extract": "attribute",
      "attribute": "href",
      "transform": "absolute_url",
      "required": true
    }
  },
  "pagination": {
    "next_selector": "ul.pager li.next a"
  },
  "max_items": 25,
  "max_pages": 100,
  "timeout_ms": 15000,
  "dedupe_by": [
    "url"
  ],
  "on_item_error": "fail"
}
